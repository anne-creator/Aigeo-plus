# 本地开发默认使用 SQLite；上线换成 Postgres 时只需改 DATABASE_URL 并把 prisma/schema.prisma 的 provider 改为 postgresql
DATABASE_URL="file:./dev.db"
# 登录会话签名密钥，上线前务必改成随机长字符串
SESSION_SECRET="geo-kpi-dev-secret-change-me-before-production"
# 上传文件存放目录（相对项目根目录）
UPLOAD_DIR="./uploads"

# 可选：三个 AI 功能共用 OpenAI API Key（仅服务器使用）
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-5.6-sol"
# 如需分别选择支持 Responses、结构化输出和 reasoning 的模型：
# OPENAI_TIMELINE_MODEL="gpt-5.6-sol"
# OPENAI_REVIEW_MODEL="gpt-5.6-sol"
# OPENAI_TASK_MODEL="gpt-5.6-sol"
