# Server-only. Copy to .env.local; never use a VITE_ prefix for credentials.
MODEL_API_URL=https://models.qubemc.com/llm/v1/chat/completions
MODEL_API_MODEL=coo-llm
MODEL_API_AUTH=
# Optional longer reasoning. Default is direct structured answers.
MODEL_ENABLE_THINKING=false
# NemoClaw is the live board backend. Use a running sandbox on this host or over SSH.
NEMOCLAW_SANDBOX=cofloor
# Optional when NemoClaw runs on the Spark and this app runs on the laptop.
# NEMOCLAW_SSH_TARGET=dell@100.89.121.112
# Optional password-authenticated SSH control socket; omit when SSH keys work.
# NEMOCLAW_SSH_CONTROL_PATH=/path/to/ssh-control-socket
# Set after adding Discord to NemoClaw. The bot token belongs to NemoClaw, never here.
NEMOCLAW_DISCORD_CHANNEL_ID=
NEMOCLAW_EMPLOYEE_MAP={}

# Current live project workflow; two different real users play these roles.
# COFLOOR_INFERENCE=nemoclaw
# COFLOOR_DISCORD=live
# COFLOOR_DISCORD_ALEX_ID=
# COFLOOR_DISCORD_MANAGER_ID=
# NEMOCLAW_PLANNER_CONFIG=/sandbox/.openclaw/cofloor-planner.json
